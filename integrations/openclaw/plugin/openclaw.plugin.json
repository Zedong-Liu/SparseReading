{
  "id": "sparseread-openclaw",
  "name": "SparseRead for OpenClaw",
  "description": "Adds SparseRead tools and optional gate hooks for long documents and compact evidence closures.",
  "version": "0.1.1",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "sro_preview",
      "sro_raw",
      "sro_card",
      "sro_read",
      "sro_decide",
      "sro_trace"
    ]
  },
  "skills": [
    "skills/sparse-reading"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "policy": {
        "type": "string",
        "enum": [
          "observe",
          "advisory",
          "enforce",
          "native",
          "auto"
        ],
        "default": "auto"
      },
      "projectRoot": {
        "type": "string"
      },
      "workspaceRoot": {
        "type": "string"
      },
      "python": {
        "type": "string"
      },
      "bridgeCommand": {
        "type": "string"
      },
      "bridgeModule": {
        "type": "string",
        "default": "sparseread_openclaw.bridge"
      },
      "bridgeProtocol": {
        "type": "string",
        "const": "1.0",
        "default": "1.0"
      },
      "mode": {
        "type": "string",
        "enum": [
          "auto",
          "bench_protocol",
          "force",
          "force_sro",
          "native",
          "advisory"
        ],
        "default": "auto"
      },
      "hookMode": {
        "type": "string",
        "enum": [
          "off",
          "trace",
          "prompt",
          "enforce"
        ],
        "default": "enforce"
      }
    }
  }
}
