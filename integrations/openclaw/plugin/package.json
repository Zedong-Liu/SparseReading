{
  "name": "@sparseread/openclaw",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "plugin:inspect": "openclaw plugins inspect sparseread-openclaw --runtime --json"
  },
  "dependencies": {
    "typebox": "1.3.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.8.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
