{
  "name": "@sparseread/pi",
  "version": "0.1.2",
  "description": "Pi coding agent extension for SparseRead",
  "keywords": [
    "pi-package",
    "sparseread"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
