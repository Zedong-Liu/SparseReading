    "test": "npm run typecheck && npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "22.15.29",
    "typebox": "1.3.27",
    "typescript": "5.8.3"
  }
}
